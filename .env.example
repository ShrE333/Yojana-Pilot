# Copy to .env and fill in. Never commit .env.

# Default provider/model for any role not set below
# providers: anthropic | openai | gemini | mock
LLM_PROVIDER=anthropic
LLM_MODEL=

# Used when the main provider hits a rate limit / quota (e.g. Groq free tier)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# Per-role overrides (optional)
EXTRACTOR_PROVIDER=
EXTRACTOR_MODEL=
AGENT_PROVIDER=
AGENT_MODEL=
# Use a different model for the judge so it does not grade its own extraction
JUDGE_PROVIDER=
JUDGE_MODEL=

# Default models when *_MODEL is empty: anthropic claude-sonnet-5-5,
# openai gpt-4.1-mini, gemini gemini-3.8-flash
# Optional Claude effort: low | medium | high | xhigh | max (empty = model default)
ANTHROPIC_EFFORT=

# Call log (metadata only, no message text). LLM_LOG=0 turns it off.
LLM_LOG_PATH=
LLM_LOG=
# With LLM_PROVIDER=mock: YAML file of {prompt substring: reply}
MOCK_LLM_FILE=

# Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For OpenAI-compatible APIs (Groq, Together, Ollama, vLLM)
OPENAI_BASE_URL=
GEMINI_API_KEY=

# Web search for scheme discovery: tavily | brave | serpapi | google_cse
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# v0.8 roles: planner = reasoning (needs analysis, search plan, reflection, which question to ask)
PLANNER_PROVIDER=
PLANNER_MODEL=
# Fallback chains, tried in order on rate limit / quota / overload / offline: provider:model,provider:model
PLANNER_FALLBACKS=
EXTRACTOR_FALLBACKS=
AGENT_FALLBACKS=
# Local models via Ollama (no quota). Default http://localhost:11434/v1
LOCAL_BASE_URL=

# Optional WhatsApp adapter; disabled until explicitly configured.
YOJANA_WAHA_ENABLED=false
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
YOJANA_WAHA_WEBHOOK_SECRET=
# Use a separate private runtime database when experimenting with ingestion.
SCHEME_DB=

# V2.4 case database (separate from the public SQLite scheme catalog).
# See deploy/.env.example and DEPLOYMENT.md for production runtime settings.
DEPLOYMENT_MODE=development
DATABASE_URL=
SESSION_AUTH_REQUIRED=false
SESSION_SIGNING_KEY=
APP_ORIGINS=
CASE_RETENTION_DAYS=30
CASE_HISTORY_LIMIT=40
WAHA_HMAC_KEY=
LLM_TIMEOUT_SECONDS=30
SSE_WINDOW_SECONDS=25

# V2.5 speech and WhatsApp-to-browser handoff; server only, never Vercel/public assets.
PUBLIC_FRONTEND_ORIGIN=
SARVAM_API_KEY=
# Optional bounded assessment question budget (1–12).
ASSESSMENT_QUESTION_BUDGET=7
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_ENABLED=false
SARVAM_STT_MODEL=saaras:v3
